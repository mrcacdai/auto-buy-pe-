# ============================================================
#  MC BEDROCK PAY BOT - FILE CAU HINH
#  Copy file nay thanh ".env" roi dien thong tin cua ban vao.
#  Luu y: KHONG chia se file .env cho bat ky ai (co token bot).
# ============================================================

# --- Discord ---
# Token cua bot (lay tu https://discord.com/developers/applications)
DISCORD_TOKEN=dán_token_bot_vào_đây

# (Tuỳ chọn) ID ứng dụng của bot - nếu bỏ trống, bot sẽ tự nhận khi đăng nhập
CLIENT_ID=

# (Tuỳ chọn) ID server Discord để đăng ký slash command NGAY LAP TUC.
# Bỏ trống = đăng ký toàn cục (global), mất tới 1 giờ mới hiện ở mọi server.
REGISTER_GUILD_ID=

# (Tuỳ chọn) Danh sách Discord User ID được phép dùng /setipserver, phân cách bằng dấu phẩy.
# Bỏ trống = chỉ chấp nhận người có quyền Administrator trên server Discord.
ADMIN_DISCORD_IDS=

# --- Webhook admin (bắt buộc để nhận ảnh chụp) ---
# Tạo tại: Cài đặt kênh -> Tích hợp (Integrations) -> Webhooks -> New Webhook -> Copy URL
ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- Minecraft PC (Java Edition) server ---
# IP/domain + port server Minecraft PC (Java) cần vào (mặc định port 25565, có thể đổi sau bằng /setipserver)
MC_HOST=donutsmp.net
MC_PORT=25565

# Tên người chơi (chế độ offline) hoặc tên hồ sơ / email Microsoft (chế độ online)
MC_USERNAME=PayBot

# Chế độ đăng nhập: offline  = tài khoản crack (server tắt online-mode)
#                   online   = tài khoản Microsoft Minecraft PC bản quyền (đăng nhập bằng mã thiết bị)
AUTH_MODE=online

# (Tuỳ chọn) Ghim phiên bản Minecraft Java, ví dụ MC_VERSION=1.21.4 hoặc 1.21.11
# Bỏ trống = tự động dò phiên bản server qua ping (khuyến nghị)
MC_VERSION=

# --- Tinh chỉnh ---
# Thời gian (ms) thu thập phản hồi lệnh trong game (/pay, /balance) trước khi chụp màn hình
PAY_CAPTURE_MS=3500

# In TOÀN BỘ chat của server ra console (cmd): tin nhắn người chơi,
# vào/ra server, thông báo hệ thống... false = tắt
CHAT_CONSOLE=true

# Vẽ watermark (tên server/phiên bản/thời điểm) lên ảnh chụp.
# Mặc định FALSE để ảnh giống 100% ảnh bấm F2 trong Minecraft PC.
SCREENSHOT_WATERMARK=false

# Hướng nhìn của bot khi render ảnh 3D (độ):
#   VIEW_YAW   = quay ngang (0 = về +z, âm = quay trái, dương = quay phải)
#   VIEW_PITCH = dọc (âm = hơi nhìn xuống, khuyến nghị -5 tới -20)
VIEW_YAW=0
VIEW_PITCH=-12

# Tên lệnh kinh tế trong game mà lệnh /balance trên Discord sẽ gọi.
# Mặc định: balance. Đổi theo plugin kinh tế của server, ví dụ:
#   EssentialsPE (Nukkit)      -> BALANCE_COMMAND=balance
#   EconomyAPI (PocketMine)    -> BALANCE_COMMAND=mymoney
#   Nukkit Essentials          -> BALANCE_COMMAND=money
BALANCE_COMMAND=balance

# Bật render 3D (ảnh có thế giới voxel). false = chỉ vẽ khung chat.
# Render 3D lỗi sẽ TỰ ĐỘNG fallback về khung chat.
RENDER_3D=true

# ============================================================
#  SHOP & PANEL (tính năng bổ sung — bán tiền in-game tự động)
#  Tắt toàn bộ bằng SHOP_ENABLED=false nếu chỉ muốn bot /pay gốc.
# ============================================================

# Bật/tắt toàn bộ shop: panel Discord, số dư, web panel, webhook bank
SHOP_ENABLED=true

# Cổng web panel quản trị (mở http://localhost:3000). 0 = tắt web panel
WEB_PORT=3000

# (Tuỳ chọn) Mật khẩu truy cập web panel. Bỏ trống = không yêu cầu (chỉ dùng localhost)
PANEL_PASSWORD=

# --- Bảng giá & kho ---
# Tỷ giá: PRICE_BASE_AMOUNT tiền game = PRICE_BASE_PRICE tiền thật
PRICE_BASE_AMOUNT=1000000
PRICE_BASE_PRICE=10000
PRICE_CURRENCY=VND

# Kho tiền game hiện có (hỗ trợ hậu tố: 1b, 500m, 100k)
SHOP_STOCK=1b

# Số phút đơn QR tự hủy nếu không thanh toán (5 - 120)
ORDER_TIMEOUT_MINUTES=15

# --- Thanh toán chuyển khoản (VietQR + Casso) ---
# BIN ngân hàng (VietQR): Vietcombank=970436, MB=970422, Techcombank=970407, Momo tạo riêng
BANK_BIN=970422
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# (Tuỳ chọn) Casso API key — để tự nhận diện giao dịch qua webhook https://portal.casso.vn
BANK_API_KEY=

# (Tuỳ chọn) Chuỗi bí mật bắt buộc trên URL webhook, vd:
#   http://ip:3000/api/webhook/bank?secret=CHUOI_BI_MAT
BANK_WEBHOOK_SECRET=

# --- Quét lịch sử MBBank tự động (ByteMart API) ---
# Token lấy từ hệ thống https://api.bytemart.io.vn (endpoint https://api.bytemart.io.vn/historyapimbbank/<token>)
# Điền token vào đây để bot tự động quét lịch sử giao dịch MBBank mà không cần mở port webhook
MBBANK_TOKEN=
# Chu kỳ quét tính bằng giây (mặc định 30, tối thiểu 10)
MBBANK_POLL_INTERVAL=30

# --- Thẻ cào (API đối tác dạng trumthengon/thesieure/thesieutoc/napthesieure) ---
# CARD_DOMAIN: Tên miền web gạch thẻ (nơi cung cấp API, vd: https://thesieutoc.net hoặc https://napthesieure.vn)
CARD_DOMAIN=
CARD_PARTNER_ID=
CARD_PARTNER_KEY=
# CARD_CALLBACK_URL: URL callback bot của bạn để web gạch thẻ gọi về (vd: https://flat-eggs-eat.loca.lt/charge/callback)
CARD_CALLBACK_URL=

# --- Kênh cảm ơn ---
# (Tuỳ chọn) ID kênh Discord để bot gửi lời cảm ơn sau mỗi đơn hàng thành công
FEEDBACK_CHANNEL_ID=

# --- Panel tự đăng ---
# (Tuỳ chọn) ID kênh Discord để bot TỰ ĐĂNG Panel bán tiền khi khởi động
# (nếu chưa từng dùng lệnh /panel). Bỏ trống = chỉ đăng bằng lệnh /panel.
SHOP_PANEL_CHANNEL_ID=

# --- Chu kỳ AFK (tùy chọn) ---
# true = bot treo online AFK_ONLINE_MINUTES phút rồi out server nghỉ AFK_REST_MINUTES phút
# (tránh bị server đánh dấu bot 24/7). Trong giờ nghỉ, nút Mua bị khoá.
AFK_CYCLE=false
AFK_ONLINE_MINUTES=720
AFK_REST_MINUTES=60

# --- Ảnh Panel Discord ---
# (Tuỳ chọn) URL ảnh thumbnail nhỏ góc phải Panel (vuông, ≥128x128px)
# Ví dụ: logo server, icon Minecraft
PANEL_THUMBNAIL_URL=

# (Tuỳ chọn) URL ảnh banner lớn phía dưới Panel (ngang, khuyến nghị 1200x400)
# Ví dụ: screenshot server, artwork quảng cáo
PANEL_BANNER_URL=
